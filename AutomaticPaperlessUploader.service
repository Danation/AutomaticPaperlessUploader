[Unit]
Description=Automatically upload scanned files to Paperless
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/dotnet /srv/AutomaticPaperlessUploader/AutomaticPaperlessUploader.dll
SyslogIdentifier=AutomaticPaperlessUploader
WorkingDirectory=/srv/AutomaticPaperlessUploader

# Runs as root because it writes the gadget LUN in sysfs and loop mounts the images.
User=root

# Holds PAPERLESS__TOKEN. Keep it mode 600 and out of git.
EnvironmentFile=-/etc/automaticpaperlessuploader.env

Restart=always
RestartSec=5

# dotnet is not on root's path by default.
Environment=DOTNET_ROOT=/opt/dotnet

[Install]
WantedBy=multi-user.target
