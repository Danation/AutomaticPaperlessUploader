{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "UserInput": {
    "AnyKeySubmits": true,
    "KeyMatrix": {
      "Layout": [
        [ "1", "2", "3", "A" ],
        [ "4", "5", "6", "B" ],
        [ "7", "8", "9", "C" ],
        [ "*", "0", "#", "D" ]
      ],
      "GPIO": {
        "OutputPins": [5, 6, 13, 19],
        "InputPins": [12, 16, 20, 21],
        "ScanIntervalMs": 20,
        "PinMode": "InputPullDown"
      }
    },
    "Actions": [
      {
        "InputCommand": "12",
        "Action": "Submit",
        "Parameters": []
      }
    ]
  },
  "Display": {
    "Enabled": true,
    "BusId": 1,
    "Address": 60,
    "Width": 128,
    "Height": 32,
    "FontFamily": "DejaVu Sans",
    "BlankAfterSeconds": 300,
    "RetryAfterSeconds": 60
  },
  "Storage": {    "Images": [ "/piusb.bin", "/piusb2.bin" ],
    "LunFilePath": "/sys/devices/platform/soc/3f980000.usb/gadget.0/lun0/file",
    "MountPoint": "/mnt/usb_share",
    "MediaChangeDelayMs": 500,
    "SubmitCooldownMs": 3000,
    "QuietPeriodMs": 3000,
    "MaxWaitForQuietMs": 30000
  },
  "Paperless": {
    "BaseUrl": "https://paperless.minert.net",
    "Token": "",
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".tif", ".tiff" ],
    "Tags": [ "Change Ownership to Elise", "Needs Review" ],
    "DeleteAfterUpload": true,
    "TimeoutSeconds": 120
  }
}
